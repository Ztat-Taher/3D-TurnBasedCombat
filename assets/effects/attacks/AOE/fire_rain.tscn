}

float rand_range(inout uint seed, float l, float h) {
	return l + (h - l) * rand(seed);
}


varying flat uint instance_id;


void vertex()
{
	instance_id = uint(INSTANCE_ID);
}

void fragment()
{
	uint seed = instance_id;
	vec4 tex_sampled_1 = texture(tex_1, UV + speed_1 * tiling_1 * TIME);
	vec4 tex_sampled_2 = texture(tex_2, UV * tiling_2 + offset_2 + vec2(rand_range(seed, 0.0, 1.0), rand_range(seed, 0.0, 1.0)) + speed_2 * tiling_2 * TIME);
	vec4 tex_sampled_3 = texture(tex_3, UV * tiling_3 + offset_3 + vec2(rand_range(seed, 0.0, 1.0), rand_range(seed, 0.0, 1.0)) + speed_3 * tiling_3 * TIME);
	vec4 tex_sampled_4 = texture(tex_4, UV + speed_4 * tiling_4 * TIME);
	ALPHA = COLOR.a;
	ALPHA = ALPHA * tex_sampled_1.r;
	//ALPHA = ALPHA * tex_sampled_2.r;
	//ALPHA = ALPHA * tex_sampled_3.r;
	ALPHA = ALPHA * tex_sampled_4.r;
	ALPHA = clamp(ALPHA * opacity, 0.0, 1.0);
	ALBEDO = COLOR.rgb * emission;
	ALBEDO *= tex_sampled_1.rgb;
	ALBEDO *= tex_sampled_2.rgb;
	ALBEDO *= tex_sampled_3.rgb;
	ALBEDO *= tex_sampled_4.rgb;
	
}


"

