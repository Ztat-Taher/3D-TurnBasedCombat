[sub_resource type="Shader" id="Shader_fl3cn"]
code = "shader_type particles;
render_mode disable_velocity;

const float DEG_TO_RAD = PI / 180.0;
const uint AMOUNT = uint(96);

struct Particle {
	uint seed;
	float delta;
	float lifetime;
	uint index;
	uint number;
	float age;
	float normalized_age;
	float normalized_index;
	float normalized_number;
	vec3 initial_position;
	vec3 initial_scale;
	vec4 initial_color;
	vec3 initial_velocity;
	float radial_velocity;
	vec3 orbital_axis;
	float initial_orbital_speed;
	vec3 spawn_direction;
	vec3 position;
	vec3 scale;
	vec4 color;
	vec3 velocity;
	vec3 orbital_velocity;
	float orbital_speed;
	vec3 rotation_axis;
	float initial_rotation;
	float rotation;
	mat3 orientation;
	vec3 force;
	float animation_offset;
	float animation_speed;
	mat4 emission_transform;
	mat4 previous_transform;
	bool just_spawned;
	bool collided;
	vec3 collision_normal;
	float collision_depth;
};

float remap(float value, float input_min, float input_max, float output_min, float output_max) {
	float v = clamp(value, input_min, input_max);
	return (v - input_min) / (input_max - input_min) * (output_max - output_min) + output_min;
}

float rand(inout uint seed) {
	int k;
	int s = int(seed);
	if (s == 0) {
		s = 305420679;
	}
	k = s / 127773;
	s = 16807 * (s - k * 127773) - 2836 * k;
	if (s < 0) {
		s += 2147483647;
	}
	seed = uint(s);
	return float(seed % uint(65536)) / 65535.0;
}

float rand_range(inout uint seed, float l, float h) {
	return l + (h - l) * rand(seed);
}

uint hash(uint x) {
	x = ((x >> uint(16)) ^ x) * uint(73244475);
	x = ((x >> uint(16)) ^ x) * uint(73244475);
	x = (x >> uint(16)) ^ x;
	return x;
}

vec3 normalize_or_zero(vec3 v) {
  return length(v) > 0.0 ? normalize(v) : vec3(0.0, 0.0, 0.0);
}

vec3 normalize_or_up(vec3 v) {
  return length(v) > 0.0 ? normalize(v) : vec3(0.0, 1.0, 0.0);
}

vec4 quat(vec3 axis, float angle) {
  float s = sin(angle / 2.0);
  return vec4(axis.x * s, axis.y * s, axis.z * s, cos(angle / 2.0));
}

vec4 quat_rotation_to(vec3 from, vec3 to) {
	vec3 xunit = vec3(1.0, 0.0, 0.0);
	vec3 yunit = vec3(0.0, 1.0, 0.0);
	float dot = dot(from, to);
	if (dot < -0.999999) {
	    vec3 axis = cross(xunit, from);
	    if (length(axis) < 0.000001) {
	    	axis = cross(yunit, from);
	    }
	    axis = normalize(axis);
	    return quat(axis, PI);
	} else if (dot > 0.999999) {
		return vec4(0.0, 0.0, 0.0, 1.0);
	} else {
		vec3 axis = cross(from, to);
		return normalize(vec4(axis, 1.0 + dot));
	}
}

vec3 rotated(vec3 v, vec3 axis, float angle) {
  vec4 q = quat(axis, angle);
  vec3 t = cross(q.xyz, v) + q.w * v;
  return v + 2.0 * cross(q.xyz, t);
}

vec3 rotated(vec3 v, vec4 q) {
  vec3 t = cross(q.xyz, v) + q.w * v;
  return v + 2.0 * cross(q.xyz, t);
}

mat3 rotated(mat3 m, vec4 q) {
  return mat3(rotated(m[0], q), rotated(m[1], q), rotated(m[2], q));
}

float normalized_by_amount(uint n) {
	return float(n) / float(max(AMOUNT, 1u));
}
void update_orbital_velocity(inout Particle particle, mat4 emission_transform, mat4 transform) {
	if (abs(particle.orbital_speed) < 0.01 || particle.delta < 0.001) { return; }
	vec3 local_pos = (inverse(emission_transform) * transform[3]).xyz;
	vec3 next = rotated(local_pos, particle.orbital_axis, particle.orbital_speed * particle.delta);
	particle.position = (emission_transform * vec4(next, 0.0)).xyz;
	particle.orbital_velocity = (next - local_pos) / particle.delta;
}

void apply_radial_velocity(inout Particle particle) {
	vec3 d = particle.position;
	float mag = min(length(d), abs(particle.radial_velocity) * particle.delta);
	particle.position += normalize_or_zero(d) * mag * sign(particle.radial_velocity);
}

void m0_shape_location_sphere(inout Particle particle) {
	float r = 1.0;
	float u = rand_range(particle.seed, 0.000000, 1.000000);
	float v = rand_range(particle.seed, 0.000000, 0.500000);
	vec3 n = vec3(1.0, 0.0, 0.0);
	n = rotated(n, vec3(0.0, 1.0, 0.0), u * 360.0 * DEG_TO_RAD);
	float h = 1.0 - 2.0 * v;
	n = normalize(n * (1.0 - abs(h)) + vec3(0.0, h, 0.0));
	particle.initial_position = n * r * 0.100000 + vec3(0.000000, 0.000000, 0.000000);
}

void m1_initialize_velocity_from_point(inout Particle particle) {
	float v = rand_range(particle.seed, 5.000000, 15.000000);
	vec3 front = vec3(0.0, 0.0, 1.0);
	vec3 to = -normalize(particle.initial_position);
	vec4 q = quat_rotation_to(front, to);
	vec3 right = rotated(vec3(1.0, 0.0, 0.0), q);
	particle.initial_velocity = normalize(particle.initial_position) * v;
}

void m2_initialize_size(inout Particle particle) {
	float s_c = rand_range(particle.seed, 0.050000, 0.100000);
	vec3 s = vec3(s_c, s_c, s_c);
	particle.initial_scale = s;
}

uniform vec4 u_m3_rgb : source_color;

void m3_initialize_color(inout Particle particle) {
	vec4 c = u_m3_rgb;
	float a = 1.0;
	particle.initial_color = vec4(c.rgb, a);
}

uniform sampler2D u_m4_influence_scale : repeat_disable;

// Functions for 3D noise / turbulence.
vec4 grad(vec4 p) {
	p = fract(vec4(
			dot(p, vec4(0.143081, 0.001724, 0.280166, 0.262771)),
			dot(p, vec4(0.645401, -0.047791, -0.146698, 0.595016)),
			dot(p, vec4(-0.499665, -0.095734, 0.425674, -0.207367)),
			dot(p, vec4(-0.013596, -0.848588, 0.423736, 0.17044))));
	return fract((p.xyzw * p.yzwx) * 2365.952041) * 2.0 - 1.0;
}

float noise(vec4 coord) {
	// Domain rotation to improve the look of XYZ slices + animation patterns.
	coord = vec4(
			coord.xyz + dot(coord, vec4(vec3(-0.1666667), -0.5)),
			dot(coord, vec4(0.5)));
	vec4 base = floor(coord), delta = coord - base;
	vec4 grad_0000 = grad(base + vec4(0.0, 0.0, 0.0, 0.0)), grad_1000 = grad(base + vec4(1.0, 0.0, 0.0, 0.0));
	vec4 grad_0100 = grad(base + vec4(0.0, 1.0, 0.0, 0.0)), grad_1100 = grad(base + vec4(1.0, 1.0, 0.0, 0.0));
	vec4 grad_0010 = grad(base + vec4(0.0, 0.0, 1.0, 0.0)), grad_1010 = grad(base + vec4(1.0, 0.0, 1.0, 0.0));
	vec4 grad_0110 = grad(base + vec4(0.0, 1.0, 1.0, 0.0)), grad_1110 = grad(base + vec4(1.0, 1.0, 1.0, 0.0));
	vec4 grad_0001 = grad(base + vec4(0.0, 0.0, 0.0, 1.0)), grad_1001 = grad(base + vec4(1.0, 0.0, 0.0, 1.0));
	vec4 grad_0101 = grad(base + vec4(0.0, 1.0, 0.0, 1.0)), grad_1101 = grad(base + vec4(1.0, 1.0, 0.0, 1.0));
	vec4 grad_0011 = grad(base + vec4(0.0, 0.0, 1.0, 1.0)), grad_1011 = grad(base + vec4(1.0, 0.0, 1.0, 1.0));
	vec4 grad_0111 = grad(base + vec4(0.0, 1.0, 1.0, 1.0)), grad_1111 = grad(base + vec4(1.0, 1.0, 1.0, 1.0));
	vec4 result_0123 = vec4(
			dot(delta - vec4(0.0, 0.0, 0.0, 0.0), grad_0000), dot(delta - vec4(1.0, 0.0, 0.0, 0.0), grad_1000),
			dot(delta - vec4(0.0, 1.0, 0.0, 0.0), grad_0100), dot(delta - vec4(1.0, 1.0, 0.0, 0.0), grad_1100));
	vec4 result_4567 = vec4(
			dot(delta - vec4(0.0, 0.0, 1.0, 0.0), grad_0010), dot(delta - vec4(1.0, 0.0, 1.0, 0.0), grad_1010),
			dot(delta - vec4(0.0, 1.0, 1.0, 0.0), grad_0110), dot(delta - vec4(1.0, 1.0, 1.0, 0.0), grad_1110));
	vec4 result_89AB = vec4(
			dot(delta - vec4(0.0, 0.0, 0.0, 1.0), grad_0001), dot(delta - vec4(1.0, 0.0, 0.0, 1.0), grad_1001),
			dot(delta - vec4(0.0, 1.0, 0.0, 1.0), grad_0101), dot(delta - vec4(1.0, 1.0, 0.0, 1.0), grad_1101));
	vec4 result_CDEF = vec4(
			dot(delta - vec4(0.0, 0.0, 1.0, 1.0), grad_0011), dot(delta - vec4(1.0, 0.0, 1.0, 1.0), grad_1011),
			dot(delta - vec4(0.0, 1.0, 1.0, 1.0), grad_0111), dot(delta - vec4(1.0, 1.0, 1.0, 1.0), grad_1111));
	vec4 fade = delta * delta * delta * (10.0 + delta * (-15.0 + delta * 6.0));
	vec4 result_W0 = mix(result_0123, result_89AB, fade.w), result_W1 = mix(result_4567, result_CDEF, fade.w);
	vec4 result_WZ = mix(result_W0, result_W1, fade.z);
	vec2 result_WZY = mix(result_WZ.xy, result_WZ.zw, fade.y);
	return mix(result_WZY.x, result_WZY.y, fade.x);
}

// Curl 3D and three-noise function with friendly permission by Isaac Cohen.
// Modified to accept 4D noise.
vec3 noise_3x(vec4 p) {
	float s = noise(p);
	float s1 = noise(p + vec4(vec3(0.0), 1.7320508 * 2048.333333));
	float s2 = noise(p - vec4(vec3(0.0), 1.7320508 * 2048.333333));
	vec3 c = vec3(s, s1, s2);
	return c;
}

vec3 curl_3d(vec4 p, float c) {
	float epsilon = 0.001 + c;
	vec4 dx = vec4(epsilon, 0.0, 0.0, 0.0);
	vec4 dy = vec4(0.0, epsilon, 0.0, 0.0);
	vec4 dz = vec4(0.0, 0.0, epsilon, 0.0);
	vec3 x0 = noise_3x(p - dx).xyz;
	vec3 x1 = noise_3x(p + dx).xyz;
	vec3 y0 = noise_3x(p - dy).xyz;
	vec3 y1 = noise_3x(p + dy).xyz;
	vec3 z0 = noise_3x(p - dz).xyz;
	vec3 z1 = noise_3x(p + dz).xyz;
	float x = (y1.z - y0.z) - (z1.y - z0.y);
	float y = (z1.x - z0.x) - (x1.z - x0.z);
	float z = (x1.y - x0.y) - (y1.x - y0.x);
	return normalize(vec3(x, y, z));
}

vec3 get_noise_direction(vec3 pos, float t) {
	float adj_contrast = max((1.000000 - 1.0), 0.0) * 70.0;
	vec4 noise_time = t * vec4(1.000000, 1.000000, 1.000000, 0.200000);
	vec4 noise_pos = vec4(pos * 0.500000, 0.0);
	vec3 noise_direction = curl_3d(noise_pos + noise_time, adj_contrast);
	noise_direction = mix(0.9 * noise_direction, noise_direction, 1.000000 - 9.0);
	return noise_direction;
}

void m4_noise(inout Particle particle) {
	float adjust = texture(u_m4_influence_scale, vec2(particle.normalized_age)).r;
	float initial_influence = rand_range(particle.seed, 0.100000, 1.000000);
	float influence = initial_influence * adjust;
	vec3 noise_direction = normalize(get_noise_direction(particle.position, particle.normalized_age));
	particle.velocity = mix(particle.velocity, noise_direction * length(particle.velocity) * (1.0 + (1.0 - influence) * 0.2), influence);
}

void m5_drag(inout Particle particle) {
	float limit = 1.0;
	float drag = 6.0;
	float speed = length(particle.velocity);
	float excess = max(0.0, speed - limit);
	vec3 dir = normalize_or_up(particle.velocity);
	particle.velocity = dir * (speed - particle.delta * excess * max(drag, 0.0));
}

void m6_align(inout Particle particle) {
	vec3 up = vec3(0.0, 1.0, 0.0);
	vec3 v = normalize(particle.velocity + particle.orbital_velocity + normalize(particle.position) * particle.radial_velocity);
	vec4 q = quat_rotation_to(up, v);
	mat3 m = mat3(1.0);
	particle.orientation = rotated(m, q);
}

uniform sampler2D u_m7_scale : repeat_disable;

void m7_scale_size(inout Particle particle) {
	vec3 s = vec3(texture(u_m7_scale, vec2(particle.normalized_age)).r);
	particle.scale *= s;
}


void initialize(inout Particle particle) {
	particle.initial_position = vec3(0.0);
	particle.initial_color = vec4(1.0);
	particle.initial_scale = vec3(1.0);
	particle.initial_velocity = vec3(0.0);
	particle.initial_orbital_speed = 0.0;
	particle.spawn_direction = vec3(0.0);
	particle.animation_offset = 0.0;
	particle.animation_speed = 1.0;
	particle.rotation_axis = vec3(1.0, 0.0, 0.0);
	particle.initial_rotation = 0.0;
	particle.radial_velocity = 0.0;
	particle.orbital_axis = vec3(0.0, 1.0, 0.0);
	particle.orbital_velocity = vec3(0.0);
	m0_shape_location_sphere(particle);
	m1_initialize_velocity_from_point(particle);
	m2_initialize_size(particle);
	m3_initialize_color(particle);
	particle.scale = particle.initial_scale;
	particle.color = particle.initial_color;
	particle.orbital_speed = particle.initial_orbital_speed;
}

void start() {
	Particle particle;
	// Use INDEX instead of NUMBER for repeatability.
	uint base_number = NUMBER;
	particle.seed = hash(base_number + uint(1) + RANDOM_SEED);
	particle.lifetime = LIFETIME;
	particle.index = INDEX;
	particle.number = NUMBER;
	particle.age = 0.0;
	particle.normalized_age = 0.0;
	particle.normalized_index = normalized_by_amount(INDEX);
	particle.normalized_number = normalized_by_amount(NUMBER);
	particle.position = vec3(0.0);
	initialize(particle);
	if (rand(particle.seed) > AMOUNT_RATIO) {
		ACTIVE = false;
	}
	if (RESTART_CUSTOM) {
		CUSTOM = vec4(0.0);
		CUSTOM.x = particle.initial_rotation;
	}
	if (RESTART_COLOR) {
		COLOR = particle.initial_color;
	}
	if (RESTART_ROT_SCALE) {
		TRANSFORM[0].xyz = rotated(vec3(1.0, 0.0, 0.0), particle.rotation_axis, particle.initial_rotation) * particle.initial_scale.x;
		TRANSFORM[1].xyz = rotated(vec3(0.0, 1.0, 0.0), particle.rotation_axis, particle.initial_rotation) * particle.initial_scale.y;
		TRANSFORM[2].xyz = rotated(vec3(0.0, 0.0, 1.0), particle.rotation_axis, particle.initial_rotation) * particle.initial_scale.z;
	}
	if (RESTART_POSITION) {
		TRANSFORM[3].xyz = particle.initial_position;
		TRANSFORM = EMISSION_TRANSFORM * TRANSFORM;
	}
	if (RESTART_VELOCITY) {
		VELOCITY = (EMISSION_TRANSFORM * vec4(particle.initial_velocity, 0.0)).xyz;
		VELOCITY += EMITTER_VELOCITY * 0.0;//inherit_emitter_velocity_ratio;
	}
}

void process() {
	Particle particle;
	// Use INDEX instead of NUMBER for repeatability.
	uint base_number = NUMBER;
	particle.seed = hash(base_number + uint(1) + RANDOM_SEED);
	particle.delta = DELTA;
	particle.lifetime = LIFETIME;
	particle.index = INDEX;
	particle.number = NUMBER;
	particle.age = 0.0;
	particle.normalized_age = 0.0;
	particle.normalized_index = normalized_by_amount(INDEX);
	particle.normalized_number = normalized_by_amount(NUMBER);
	particle.position = TRANSFORM[3].xyz;
	particle.velocity = VELOCITY;
	particle.orientation = mat3(
		normalize(TRANSFORM[0].xyz),
		normalize(TRANSFORM[1].xyz),
		normalize(TRANSFORM[2].xyz));
	particle.force = vec3(0.0);
	particle.emission_transform = EMISSION_TRANSFORM;
	particle.previous_transform = TRANSFORM;
	particle.rotation = CUSTOM.x;
	particle.just_spawned = CUSTOM.y == 0.0;
	particle.collided = COLLIDED;
	particle.collision_normal = COLLISION_NORMAL;
	particle.collision_depth = COLLISION_DEPTH;
	initialize(particle);
	CUSTOM.y += DELTA / particle.lifetime;
	CUSTOM.y = mix(CUSTOM.y, 1.0, INTERPOLATE_TO_END);
	CUSTOM.y = clamp(CUSTOM.y, 0.0, 1.0);
	particle.age = CUSTOM.y * particle.lifetime;
	particle.normalized_age = CUSTOM.y;
	m4_noise(particle);
	m5_drag(particle);
	m6_align(particle);
	m7_scale_size(particle);
	if (abs(particle.orbital_speed) >= 0.01 && particle.delta >= 0.001) {
		vec3 local_pos = (inverse(particle.emission_transform) * vec4(particle.position, 1.0)).xyz;
		vec3 next = rotated(local_pos, particle.orbital_axis, particle.orbital_speed * particle.delta);
		particle.position = (particle.emission_transform * vec4(next, 0.0)).xyz;
		particle.orbital_velocity = (next - local_pos) / particle.delta;
	}
	if (abs(particle.radial_velocity) >= 0.01 && particle.delta >= 0.001) {
		vec3 local_pos = (inverse(particle.emission_transform) * vec4(particle.position, 1.0)).xyz;
		vec3 d = local_pos;
		float mag = min(length(d), abs(particle.radial_velocity) * particle.delta);
		vec3 next = local_pos + normalize_or_zero(d) * mag * sign(particle.radial_velocity);
		particle.position = (particle.emission_transform * vec4(next, 0.0)).xyz;
	}
	particle.position += particle.velocity * particle.delta;
	VELOCITY = particle.velocity;
	TRANSFORM[0].xyz = particle.orientation[0] * particle.scale.x;
	TRANSFORM[1].xyz = particle.orientation[1] * particle.scale.y;
	TRANSFORM[2].xyz = particle.orientation[2] * particle.scale.z;
	TRANSFORM[3].xyz = particle.position;
	COLOR = particle.color;
	CUSTOM.x = particle.rotation;
	
	if (particle.age >= LIFETIME) { ACTIVE = false;  }
}

