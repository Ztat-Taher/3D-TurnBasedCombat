[sub_resource type="Shader" id="Shader_8lb58"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled;

uniform float opacity = 1.0;
uniform float emission = 1.0;

uniform sampler2D tex_1 : source_color, filter_linear_mipmap, repeat_disable;
uniform vec2 tiling_1 = vec2(1.0);
uniform vec2 offset_1 = vec2(0.0);
uniform vec2 speed_1 = vec2(0.0);

uniform sampler2D tex_2 : source_color, filter_linear_mipmap, repeat_enable;
uniform vec2 tiling_2 = vec2(1.0);
uniform vec2 offset_2 = vec2(0.0);
uniform vec2 speed_2 = vec2(0.0);

uniform sampler2D gradient : source_color, repeat_disable;

float rand(inout uint seed) {
	int k;
	int s = int(seed);
	if (s == 0) {
		s = 305420679;
	}
	k = s / 127773;
	s = 16807 * (s - k * 127773) - 2836 * k;
	if (s < 0) {
		s += 2147483647;
	}
	seed = uint(s);
	return float(seed % uint(65536)) / 65535.0;
}

float rand_range(inout uint seed, float l, float h) {
	return l + (h - l) * rand(seed);
}


varying flat uint instance_id;


void vertex()
{
	instance_id = uint(INSTANCE_ID);
}

void fragment()
{
	uint seed = instance_id;
	vec4 tex_sampled_1 = texture(tex_1, UV + speed_1 * tiling_1 * TIME);
	vec4 tex_sampled_2 = texture(tex_2, UV + speed_2 * tiling_2 * TIME);
	ALPHA = COLOR.a;
	ALPHA = ALPHA * tex_sampled_1.r;
	//ALPHA = max(smoothstep(0.99, 1.0, ALPHA), ALPHA * tex_sampled_2.r);
	ALPHA = ALPHA * tex_sampled_2.r;
	ALPHA = clamp(ALPHA * opacity, 0.0, 1.0);
	
	float feather = 0.01;
	float threshold = 0.2;
	ALBEDO = COLOR.rgb * emission * texture(gradient, vec2(tex_sampled_2.r)).rgb;
	
	ALPHA = smoothstep(threshold, threshold + feather, ALPHA);
}


"

