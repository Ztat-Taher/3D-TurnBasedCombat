[sub_resource type="Shader" id="Shader_ek454"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled;

uniform float opacity = 1.0;
uniform float emission = 1.0;

uniform sampler2D tex_1 : source_color, filter_linear_mipmap, repeat_enable;
uniform vec2 tiling_1 = vec2(1.0);
uniform vec2 offset_1 = vec2(0.0);
uniform vec2 speed_1 = vec2(0.0);

uniform sampler2D tex_2 : source_color, filter_linear_mipmap, repeat_enable;
uniform vec2 tiling_2 = vec2(1.0);
uniform vec2 offset_2 = vec2(0.0);
uniform vec2 speed_2 = vec2(0.0);

uniform sampler2D mask : source_color, filter_linear_mipmap, repeat_disable;

uniform float distortion = 0.5;

float rand(inout uint seed) {
	int k;
	int s = int(seed);
	if (s == 0) {
		s = 305420679;
	}
	k = s / 127773;
	s = 16807 * (s - k * 127773) - 2836 * k;
	if (s < 0) {
		s += 2147483647;
	}
	seed = uint(s);
	return float(seed % uint(65536)) / 65535.0;
}

float rand_range(inout uint seed, float l, float h) {
	return l + (h - l) * rand(seed);
}


varying flat uint instance_id;
varying float age;


void vertex()
{
	instance_id = uint(INSTANCE_ID);
	age = INSTANCE_CUSTOM.y;
}

float remap(float value, float input_min, float input_max, float output_min, float output_max) {
	return (clamp(value, input_min, input_max) - input_min) / (input_max - input_min) * (output_max - output_min) + output_min;
}

void fragment()
{
	uint seed = instance_id;
	float m = texture(mask, UV).r;
	vec4 tex_sampled_2 = texture(tex_2, UV * tiling_2 + vec2(rand_range(seed, 0.0, 1.0), rand_range(seed, 0.0, 1.0)) + speed_2 * tiling_2 * TIME);
	vec4 tex_sampled_1 = texture(tex_1, UV + speed_1 * tiling_1 * age - vec2(0.0, 1.0) - tex_sampled_2.r * distortion);
	float feather = 0.2;
	float edge = remap(min(age + .3, .75), 0.0, 1.0, -feather, 1.0);
	float timed_mask = 1.0 - smoothstep(edge, edge + feather, 1.0 - UV.y);
	ALPHA = COLOR.a;
	ALPHA = ALPHA * tex_sampled_1.r * timed_mask * m;
	ALPHA = clamp(ALPHA * opacity, 0.0, 1.0);
	ALBEDO = COLOR.rgb * emission;
	ALBEDO *= tex_sampled_1.rgb;
	//ALPHA = timed_mask;
	//ALBEDO = vec3(timed_mask);
	
}


"

