		for (int i = 0; i < 4; i++) { emit_subparticle(TRANSFORM, vec3(0.0), vec4(0.0), vec4(0.0), FLAG_EMIT_POSITION); }
	}
	if (particle.collided) {
		ACTIVE = false;
	}
	if (particle.age >= LIFETIME) { ACTIVE = false;  }
}

"

