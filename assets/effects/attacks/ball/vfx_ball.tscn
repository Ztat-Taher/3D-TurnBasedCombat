struct Particle {
	uint seed;
	float delta;
	float lifetime;
	uint index;
	uint number;
	float age;
	float normalized_age;
	float normalized_index;
	float normalized_number;
	vec3 initial_position;
	vec3 initial_scale;
	vec4 initial_color;
	vec3 initial_velocity;
