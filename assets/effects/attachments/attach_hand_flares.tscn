uniform vec4 initial_color : source_color;

void m1_initialize_color(inout Particle particle) {
	vec4 c = initial_color;
	float a = 1.0;
	particle.initial_color = vec4(c.rgb, a);
}

void m2_shape_location_sphere(inout Particle particle) {
	float r = rand_range(particle.seed, 0.000000, 1.000000);
	float u = rand_range(particle.seed, 0.000000, 1.000000);
	float v = rand_range(particle.seed, 0.000000, 1.000000);
	vec3 n = vec3(1.0, 0.0, 0.0);
	n = rotated(n, vec3(0.0, 1.0, 0.0), u * 360.0 * DEG_TO_RAD);
	float h = 1.0 - 2.0 * v;
	n = normalize(n * (1.0 - abs(h)) + vec3(0.0, h, 0.0));
	particle.spawn_direction = normalize_or_up(n * vec3(1.000000, 1.000000, 1.000000));
	particle.initial_position = particle.spawn_direction * r * 0.200000 + vec3(0.000000, 0.000000, 0.000000);
}

void m3_initialize_velocity(inout Particle particle) {
	float v = 0.15;
	particle.initial_velocity = particle.spawn_direction * v;
}

uniform sampler2D u_m4_scale : repeat_disable;

void m4_scale_size(inout Particle particle) {
	vec3 s = vec3(texture(u_m4_scale, vec2(particle.normalized_age)).r);
	particle.scale *= s;
}

void m5_add_force(inout Particle particle) {
	vec3 f = vec3(0.000000, -0.300000, 0.000000);
	particle.force += f;
}

void m6_solve_forces_and_velocity(inout Particle particle) {
	particle.velocity += particle.force * particle.delta;
	if (abs(particle.orbital_speed) >= 0.01 && particle.delta >= 0.001) {
		vec3 local_pos = (inverse(particle.emission_transform) * vec4(particle.position, 1.0)).xyz;
		vec3 next = rotated(local_pos, particle.orbital_axis, particle.orbital_speed * particle.delta);
