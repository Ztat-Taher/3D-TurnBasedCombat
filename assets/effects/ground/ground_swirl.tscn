[sub_resource type="Shader" id="Shader_gy14c"]
code = "shader_type spatial;
render_mode unshaded, blend_add, cull_disabled;

uniform float opacity = 1.0;
uniform sampler2D distortion_tex : source_color, filter_linear, repeat_enable;
uniform vec2 distortion_tiling = vec2(1.0);
uniform vec2 distortion_offset = vec2(0.0);
uniform vec2 distortion_speed = vec2(0.0);

uniform vec2 distortion_power = vec2(0.0);

uniform sampler2D distortion_curve : filter_linear, repeat_disable;

uniform sampler2D main_tex : source_color, filter_linear_mipmap, repeat_disable;
uniform vec2 main_tiling = vec2(1.0);
uniform vec2 main_offset = vec2(0.0);

uniform sampler2D gradient : source_color, repeat_disable;

uniform sampler2D emission_curve: repeat_disable, filter_linear;

uniform float alpha_threshold : hint_range(0.0, 1.0, 0.01) = 0.01;
uniform float alpha_feather : hint_range(0.0, 1.0, 0.01) = 0.025;

float rand(inout uint seed) {
	int k;
	int s = int(seed);
	if (s == 0) {
		s = 305420679;
	}
	k = s / 127773;
	s = 16807 * (s - k * 127773) - 2836 * k;
	if (s < 0) {
		s += 2147483647;
	}
	seed = uint(s);
	return float(seed % uint(65536)) / 65535.0;
}

float rand_range(inout uint seed, float l, float h) {
	return l + (h - l) * rand(seed);
}

varying flat uint instance_id;
varying float age;

void vertex()
{
	instance_id = uint(INSTANCE_ID);
	age = INSTANCE_CUSTOM.y;
}

void fragment()
{
	uint seed = instance_id;
	float distortion_s = texture(distortion_tex, UV * distortion_tiling + distortion_offset + vec2(rand_range(seed, 0.0, 1.0), rand_range(seed, 0.0, 1.0)) + distortion_speed * TIME).r;
	vec2 distortion = distortion_power * distortion_s;
	distortion *= texture(distortion_curve, vec2(age)).r;
	vec4 main_s = texture(main_tex, UV * main_tiling + main_offset + distortion);
	ALPHA = COLOR.a;
	ALPHA *= main_s.r;
	ALPHA = clamp(ALPHA * opacity, 0.0, 1.0);
	ALPHA = smoothstep(alpha_threshold, alpha_threshold + alpha_feather, ALPHA);
	ALBEDO = COLOR.rgb;
	ALBEDO *= texture(gradient, vec2(ALPHA)).rgb;
	ALBEDO *= texture(emission_curve, vec2(ALPHA)).r;
	
}


"

